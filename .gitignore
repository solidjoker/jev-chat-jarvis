# Build
/build/
/app/build/
.gradle/
*.apk
*.ap_
*.dex
*.class
local.properties

# Machine-specific
env.ps1
gradle.properties.local

# IDE
.idea/
*.iml
.vscode/

# Dev artifacts / reports (not part of the product)
/_reports/
/tools/jev/report/
/tools/jev/__pycache__/
**/__pycache__/
*.pyc
.video_agent/
/out/
.zcodeignore

# OS
.DS_Store
Thumbs.db

# Never commit secrets
*.key
secrets.*

# Prebuilt APK for direct install (tracked on purpose)
!/apk/*.apk
# …except the private build, which embeds API keys. Never tracked, never uploaded.
/apk/*private*.apk

# Private build key source — baked into the private APK only
apikey.toml

# Signing material never enters the repo
*.jks
*.keystore
keystore.properties
